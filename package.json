{
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite --host --mode development",
    "prod": "cross-env NODE_ENV=production vite --host --mode production",
    "build": "rm -rf dist && vite build --mode development",
    "build:prod": "rm -rf dist && cross-env NODE_ENV=production vite build --mode production",
    "build:analyze": "rm -rf dist && cross-env ANALYZE=1 NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "deploy": "bun run build:prod && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check:biome": "biome check src/",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:prod",
    "check:ci": "bun run check && bun audit --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "preact": "^11.1.1",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "js-yaml": "^5.4.3",
    "lodash": "^4.18.1",
    "brace-expansion": "^5.0.12",
    "flatted": "^3.4.4",
    "picomatch": ">=4.0.7",
    "yaml": ">=2.9.1"
  }
}
